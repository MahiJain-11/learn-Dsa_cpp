class Solution {
public:
    int maxProfit(vector<int>& prices) {
       int minPrices=prices[0];
       int maxProfit=0;
        int n = prices.size();
        for(int i= 0;i<n;i++){
            int profit = prices[i]-minPrices;
            maxProfit = max(maxProfit,profit);
            minPrices = min(minPrices, prices[i]);
        }
        return maxProfit;
    }
};
